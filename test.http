### 批量删除自己创建的学生
DELETE http://localhost:8080/students/batch?ids=401&ids=402
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJ1c2VySWQiOjEsInVzZXJuYW1lIjoiYWRtaW4iLCJpYXQiOjE3ODI0NjQyODIsImV4cCI6MTc4MjU1MDY4Mn0.ztGX3r-Mj9b1m_qiiA6M4bOATh1v-UwpP_torOyny4E

### 批量删除不存在的学生
DELETE http://localhost:8080/students/batch?ids=99999&ids=88888
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJ1c2VySWQiOjEsInVzZXJuYW1lIjoiYWRtaW4iLCJpYXQiOjE3ODI0NjQyODIsImV4cCI6MTc4MjU1MDY4Mn0.ztGX3r-Mj9b1m_qiiA6M4bOATh1v-UwpP_torOyny4E

### 批量删除包含别人创建的学生
DELETE http://localhost:8080/students/batch?ids=401&ids=1
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJ1c2VySWQiOjEsInVzZXJuYW1lIjoiYWRtaW4iLCJpYXQiOjE3ODI0NjQyODIsImV4cCI6MTc4MjU1MDY4Mn0.ztGX3r-Mj9b1m_qiiA6M4bOATh1v-UwpP_torOyny4E
